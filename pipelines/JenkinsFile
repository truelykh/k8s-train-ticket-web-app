pipeline {
    agent any

    environment {
        // GitHub Configuration & Credentials
        GITHUB_CRED_ID = 'github-pat'
        REPO_URL       = 'https://github.com/truelykh/k8s-train-ticket-web-app.git'
        BRANCH         = 'main'
        MANIFESTS_DIR  = 'k8s manifests'
    }

    triggers {
        // Trigger automatically when code is pushed to GitHub via Webhook
        githubPush()
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout Source Code') {
            steps {
                echo "Cloning repository from GitHub via Webhook trigger..."
                git branch: env.BRANCH,
                    credentialsId: env.GITHUB_CRED_ID,
                    url: env.REPO_URL
            }
        }

        stage('Validate Kubernetes Manifests') {
            steps {
                dir(env.MANIFESTS_DIR) {
                    echo "Validating Kubernetes manifests syntax (Dry Run)..."
                    sh '''
                        echo "==> Dry run validation for Namespaces and StorageClass..."
                        kubectl apply -f namepace.yaml --dry-run=client
                        kubectl apply -f storageclass.yaml --dry-run=client

                        echo "==> Dry run validation for Applications (Nexus, Jenkins, ArgoCD)..."
                        kubectl apply -f nexusrepo-pod.yaml --dry-run=client
                        kubectl apply -f jenkins-pod.yaml --dry-run=client
                        kubectl apply -f "argocd.-pod.yaml" --dry-run=client
                    '''
                }
            }
        }

        stage('Deploy Namespaces & StorageClass') {
            steps {
                dir(env.MANIFESTS_DIR) {
                    echo "Creating Namespaces (jenkins, nexus, argocd) & StorageClass (gp3)..."
                    sh '''
                        echo "==> Applying Namespaces..."
                        kubectl apply -f namepace.yaml

                        echo "==> Applying StorageClass..."
                        kubectl apply -f storageclass.yaml
                    '''
                }
            }
        }

        stage('Deploy Nexus Repository') {
            steps {
                dir(env.MANIFESTS_DIR) {
                    echo "Deploying Nexus Repository in namespace: nexus..."
                    sh '''
                        kubectl apply -f nexusrepo-pod.yaml
                    '''
                }
            }
        }

        stage('Deploy Jenkins') {
            steps {
                dir(env.MANIFESTS_DIR) {
                    echo "Deploying Jenkins in namespace: jenkins..."
                    sh '''
                        kubectl apply -f jenkins-pod.yaml
                    '''
                }
            }
        }

        stage('Deploy ArgoCD') {
            steps {
                dir(env.MANIFESTS_DIR) {
                    echo "Deploying ArgoCD in namespace: argocd..."
                    sh '''
                        kubectl apply -f "argocd.-pod.yaml"
                    '''
                }
            }
        }

        stage('Verify Pods & Services Status') {
            steps {
                echo "Checking deployment rollout and service endpoints..."
                sh '''
                    echo "================ Namespaces ================"
                    kubectl get ns jenkins nexus argocd

                    echo "================ Pods Status ================"
                    kubectl get pods -n nexus -o wide
                    kubectl get pods -n jenkins -o wide
                    kubectl get pods -n argocd -o wide

                    echo "================ Services ================"
                    kubectl get svc -n nexus
                    kubectl get svc -n jenkins
                    kubectl get svc -n argocd

                    echo "================ PVC Status ================"
                    kubectl get pvc -n nexus
                    kubectl get pvc -n jenkins
                '''
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo " All Kubernetes applications (Namespace, StorageClass, Nexus, Jenkins, ArgoCD) deployed successfully!"
        }
        failure {
            echo "❌ Deployment pipeline failed. Check the logs above for details."
        }
    }
}