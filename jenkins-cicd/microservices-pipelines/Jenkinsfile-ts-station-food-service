pipeline {
    agent any

    environment {
        SERVICE_NAME          = 'ts-station-food-service'
        APP_GROUP_ID          = 'org.services'
        APP_VERSION           = '0.1.0'
        APP_DIR               = 'train ticket-source code'
        K8S_MANIFEST_DIR      = 'k8s manifests'

        DOCKER_HOST           = 'tcp://localhost:2375'

        GITHUB_CRED_ID        = 'github-pat'
        REPO_URL              = 'https://github.com/truelykh/k8s-train-ticket-web-app.git'
        BRANCH                = 'main'

        NEXUS_CRED_ID         = 'nexus-credentials'
        NEXUS_HOST            = 'nexus-svc.nexus.svc.cluster.local:8081'
        NEXUS_DOCKER_REGISTRY = 'nexus-svc.nexus.svc.cluster.local:8082'
        NEXUS_MAVEN_REPO      = 'maven-releases'
        IMAGE_PREFIX          = 'truelykh'

        IMAGE_TAG_VERSION     = "v${BUILD_NUMBER}"
        GIT_SHORT_SHA         = ''
        IMAGE_FULL_TAG        = ''
    }

    parameters {
        booleanParam(name: 'RUN_TESTS',     defaultValue: true, description: 'Run unit tests and code coverage')
        booleanParam(name: 'PUBLISH_JAR',   defaultValue: true, description: 'Publish JAR artifact to Nexus Maven repository')
        booleanParam(name: 'PUSH_IMAGE',    defaultValue: true, description: 'Build and push Docker image to Nexus Registry')
        booleanParam(name: 'SECURITY_SCAN', defaultValue: true, description: 'Execute Trivy vulnerability scanning on image')
        booleanParam(name: 'AUTO_DEPLOY',   defaultValue: true, description: 'Commit updated manifest and trigger Argo CD GitOps sync')
    }

    triggers {
        githubPush()
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '25', artifactNumToKeepStr: '10'))
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {
        stage('1. SCM Checkout') {
            steps {
                git branch: env.BRANCH,
                    credentialsId: env.GITHUB_CRED_ID,
                    url: env.REPO_URL

                script {
                    def sha = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    env.GIT_SHORT_SHA  = sha
                    env.IMAGE_FULL_TAG = "${env.IMAGE_TAG_VERSION}-${sha}"
                    currentBuild.displayName = "${env.SERVICE_NAME}-#${BUILD_NUMBER} (${env.IMAGE_TAG_VERSION})"
                }
            }
        }

        stage('2. Build & Package') {
            when {
                anyOf {
                    changeset "train ticket-source code/ts-station-food-service/**"
                    changeset "train ticket-source code/ts-common/**"
                    changeset "train ticket-source code/pom.xml"
                    triggeredBy 'UserIdCause'
                }
            }
            steps {
                dir(env.APP_DIR) {
                    sh "mvn -B -pl '${SERVICE_NAME}' -am clean install -DskipTests=true -Dcheckstyle.skip=true"
                }
            }
        }

        stage('3. Unit Tests') {
            when {
                allOf {
                    expression { return params.RUN_TESTS }
                    anyOf {
                        changeset "train ticket-source code/ts-station-food-service/**"
                        changeset "train ticket-source code/ts-common/**"
                        changeset "train ticket-source code/pom.xml"
                        triggeredBy 'UserIdCause'
                    }
                }
            }
            steps {
                dir(env.APP_DIR) {
                    sh "mvn -B -pl '${SERVICE_NAME}' test"
                }
            }
            post {
                always {
                    junit testResults: "${env.APP_DIR}/${env.SERVICE_NAME}/target/surefire-reports/*.xml", allowEmptyResults: true
                }
            }
        }

        stage('4. Publish JAR to Nexus') {
            when {
                allOf {
                    expression { return params.PUBLISH_JAR }
                    anyOf {
                        changeset "train ticket-source code/ts-station-food-service/**"
                        changeset "train ticket-source code/ts-common/**"
                        changeset "train ticket-source code/pom.xml"
                        triggeredBy 'UserIdCause'
                    }
                }
            }
            steps {
                dir("${env.APP_DIR}/${env.SERVICE_NAME}") {
                    withCredentials([usernamePassword(credentialsId: env.NEXUS_CRED_ID, usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASS')]) {
                        sh '''
                            groupPath=$(echo "${APP_GROUP_ID}" | tr '.' '/')
                            jarFile=$(find target -name "*.jar" ! -name "*-sources.jar" ! -name "*-javadoc.jar" | head -n 1)
                            if [ -n "$jarFile" ]; then
                                jarName=$(basename "$jarFile")
                                curl -s -f -u "${NEXUS_USER}:${NEXUS_PASS}" \
                                    --upload-file "$jarFile" \
                                    "http://${NEXUS_HOST}/repository/${NEXUS_MAVEN_REPO}/${groupPath}/${SERVICE_NAME}/${APP_VERSION}/${jarName}" || true
                            fi
                        '''
                    }
                }
            }
        }

        stage('5. Build Docker Image') {
            when {
                allOf {
                    expression { return params.PUSH_IMAGE }
                    anyOf {
                        changeset "train ticket-source code/ts-station-food-service/**"
                        changeset "train ticket-source code/ts-common/**"
                        changeset "train ticket-source code/pom.xml"
                        triggeredBy 'UserIdCause'
                    }
                }
            }
            steps {
                dir("${env.APP_DIR}/${env.SERVICE_NAME}") {
                    sh '''
                        nexusImage="${NEXUS_DOCKER_REGISTRY}/${IMAGE_PREFIX}/${SERVICE_NAME}:${IMAGE_TAG_VERSION}"
                        nexusFull="${NEXUS_DOCKER_REGISTRY}/${IMAGE_PREFIX}/${SERVICE_NAME}:${IMAGE_FULL_TAG}"
                        nexusLatest="${NEXUS_DOCKER_REGISTRY}/${IMAGE_PREFIX}/${SERVICE_NAME}:latest"

                        docker build -t "${nexusImage}" -t "${nexusFull}" -t "${nexusLatest}" .
                    '''
                }
            }
        }

        stage('6. Security Scan (Trivy)') {
            when {
                allOf {
                    expression { return params.SECURITY_SCAN && params.PUSH_IMAGE }
                    anyOf {
                        changeset "train ticket-source code/ts-station-food-service/**"
                        changeset "train ticket-source code/ts-common/**"
                        changeset "train ticket-source code/pom.xml"
                        triggeredBy 'UserIdCause'
                    }
                }
            }
            steps {
                sh '''
                    targetImg="${NEXUS_DOCKER_REGISTRY}/${IMAGE_PREFIX}/${SERVICE_NAME}:${IMAGE_TAG_VERSION}"
                    if command -v trivy > /dev/null 2>&1; then
                        trivy image --severity HIGH,CRITICAL --no-progress --exit-code 0 "${targetImg}"
                    fi
                '''
            }
        }

        stage('7. Push Image to Nexus') {
            when {
                allOf {
                    expression { return params.PUSH_IMAGE }
                    anyOf {
                        changeset "train ticket-source code/ts-station-food-service/**"
                        changeset "train ticket-source code/ts-common/**"
                        changeset "train ticket-source code/pom.xml"
                        triggeredBy 'UserIdCause'
                    }
                }
            }
            steps {
                withCredentials([usernamePassword(credentialsId: env.NEXUS_CRED_ID, usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASS')]) {
                    sh '''
                        echo "$NEXUS_PASS" | docker login -u "$NEXUS_USER" --password-stdin "$NEXUS_DOCKER_REGISTRY"
                        docker push "${NEXUS_DOCKER_REGISTRY}/${IMAGE_PREFIX}/${SERVICE_NAME}:${IMAGE_TAG_VERSION}"
                        docker push "${NEXUS_DOCKER_REGISTRY}/${IMAGE_PREFIX}/${SERVICE_NAME}:${IMAGE_FULL_TAG}"
                        docker push "${NEXUS_DOCKER_REGISTRY}/${IMAGE_PREFIX}/${SERVICE_NAME}:latest"
                    '''
                }
            }
        }

        stage('8. Update Git Manifest (GitOps)') {
            when {
                allOf {
                    expression { return params.AUTO_DEPLOY }
                    anyOf {
                        changeset "train ticket-source code/ts-station-food-service/**"
                        changeset "train ticket-source code/ts-common/**"
                        changeset "k8s manifests/microservices/ts-station-food-service.yaml"
                        triggeredBy 'UserIdCause'
                    }
                }
            }
            steps {
                withCredentials([usernamePassword(credentialsId: env.GITHUB_CRED_ID, usernameVariable: 'GIT_USER', passwordVariable: 'GIT_TOKEN')]) {
                    sh '''
                        manifestPath="${K8S_MANIFEST_DIR}/microservices/${SERVICE_NAME}.yaml"
                        if [ -f "$manifestPath" ]; then
                            sed -i.bak "s|image: ${NEXUS_DOCKER_REGISTRY}/${IMAGE_PREFIX}/${SERVICE_NAME}:.*|image: ${NEXUS_DOCKER_REGISTRY}/${IMAGE_PREFIX}/${SERVICE_NAME}:${IMAGE_TAG_VERSION}|g" "$manifestPath"
                            rm -f "${manifestPath}.bak"

                            git config user.email "jenkins@ci.local"
                            git config user.name "Jenkins CI"
                            git add "$manifestPath"
                            if ! git diff --cached --quiet; then
                                git commit -m "ci: update ${SERVICE_NAME} image to ${IMAGE_TAG_VERSION} [skip ci]"
                                git push "https://${GIT_USER}:${GIT_TOKEN}@github.com/truelykh/k8s-train-ticket-web-app.git" "${BRANCH}"
                            fi
                        fi
                    '''
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
