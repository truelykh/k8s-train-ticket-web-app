pipeline {
    agent any

    environment {
        GITHUB_CRED_ID = 'github-pat'
        REPO_URL       = 'https://github.com/truelykh/k8s-train-ticket-web-app.git'
        BRANCH         = 'main'
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: env.BRANCH, credentialsId: env.GITHUB_CRED_ID, url: env.REPO_URL
            }
        }

        stage('Deploy Redis') {
            steps {
                sh 'kubectl apply -f "k8s manifests/db/redis.yaml"'
            }
        }

        stage('Verify Redis') {
            steps {
                sh '''
                    kubectl rollout status deployment/redis -n train-ticket --timeout=120s
                    kubectl get pods -n train-ticket -l app=redis -o wide
                    kubectl get svc -n train-ticket -l app=redis
                '''
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
